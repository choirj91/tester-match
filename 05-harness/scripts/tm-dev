#!/usr/bin/env bash
# tm-dev: choose which database `pnpm dev` talks to — no Docker.
#
#   tm-dev setup        install the PostgREST + GoTrue binaries (same versions as the
#                       App Service sidecars) into ~/.local/share/tester-match/bin
#   tm-dev local-init   build database `testermatch` on the local PostgreSQL 17
#                       (Homebrew): Supabase-compatible roles, GoTrue auth schema, the
#                       public schema copied from production (schema only), seed.sql.
#                       Drops and rebuilds the local database every time.
#       --with-prod-data  also copy production rows (public + auth.users/identities).
#                         Personal data lands on this disk — use only when needed.
#   tm-dev local        PostgREST + GoTrue on this machine against the local database
#   tm-dev prod         PostgREST + GoTrue on this machine against production Azure
#                       PostgreSQL. Real data: reads and writes hit production.
#   tm-dev off          stop PostgREST + GoTrue and remove the override file
#   tm-dev status       show the current mode and processes
#
# The mode is written to 03-output/app/.env.development.local, which Next.js loads with
# higher priority than .env.local. .env.local itself is never touched. The browser and the
# server both reach the services through the dev server (/auth/v1 rewrite, internal URLs),
# exactly as in production. Restart `pnpm dev` after switching.
#
# Secrets live outside the repo (mode 600, values single-quoted):
#   ~/.config/tester-match/prod-db.env   JWT_SECRET, ANON_JWT, SERVICE_JWT, PGRST_DB_URI,
#                                        GOTRUE_DATABASE_URL, AZURE_STORAGE_CONNECTION_STRING,
#                                        PG_ADMIN_URI (server admin; used by local-init to
#                                        read the production schema)
#   ~/.config/tester-match/local-db.env  generated by local-init
#   ~/.config/tester-match/local-google.env  GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET (optional)
#
# Guards in both modes: outgoing mail disabled (RESEND_API_KEY empty), cron routes closed
# (no CRON_SECRET, CRON_ALLOW_UNAUTHENTICATED=0), Google login off (localhost is not a
# registered redirect URI — email login only). Prod mode also disables GoTrue signup.
#
# Google login in local mode (opt-in): `TM_DEV_GOOGLE=1 tm-dev local` reads local-google.env
# (the production OAuth client) and needs "$DEV_ORIGIN/auth/v1/callback" (default
# http://localhost:3000/auth/v1/callback) in the client's authorized redirect URIs.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
APP_DIR="$ROOT/03-output/app"
DB_SQL_DIR="$ROOT/03-output/infra/azure/db"
SEED_SQL="$ROOT/03-output/supabase/seed.sql"
OVERRIDE="$APP_DIR/.env.development.local"
CONFIG_DIR="$HOME/.config/tester-match"
PROD_ENV="${TM_PROD_DB_ENV:-$CONFIG_DIR/prod-db.env}"
LOCAL_ENV="$CONFIG_DIR/local-db.env"
GOOGLE_ENV="$CONFIG_DIR/local-google.env"
BIN_DIR="${TM_BIN_DIR:-$HOME/.local/share/tester-match/bin}"
STATE_DIR="${TM_STATE_DIR:-$HOME/.local/state/tester-match}"
DEV_ORIGIN="${TM_DEV_ORIGIN:-http://localhost:3000}"

LOCAL_PGHOST="${TM_LOCAL_PGHOST:-127.0.0.1}"
LOCAL_PGPORT="${TM_LOCAL_PGPORT:-5432}"
LOCAL_DB="testermatch"   # 01-roles.sql grants on this database name

POSTGREST_VERSION="v16.4"
GOTRUE_VERSION="v2.197.0"
POSTGREST_PORT=3001
GOTRUE_PORT=9999

die() { echo "tm-dev: $1" >&2; exit 1; }

load_env() {  # load_env <file>
  [[ -f "$1" ]] || die "$1 not found"
  [[ "$(stat -f %Lp "$1" 2>/dev/null || stat -c %a "$1")" == 600 ]] || die "$1 must be mode 600"
  # shellcheck disable=SC1090
  set -a; source "$1"; set +a
}

# ---------------------------------------------------------------- binaries

cmd_setup() {
  local arch tmp
  arch="$(uname -m)"
  [[ "$(uname -s)" == Darwin && "$arch" == arm64 ]] || die "setup only knows macOS arm64; install postgrest $POSTGREST_VERSION and supabase/auth $GOTRUE_VERSION into $BIN_DIR yourself"
  mkdir -p "$BIN_DIR"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN
  if [[ ! -x "$BIN_DIR/postgrest" ]]; then
    curl -fsSL -o "$tmp/pgrst.tar.xz" \
      "https://github.com/PostgREST/postgrest/releases/download/$POSTGREST_VERSION/postgrest-$POSTGREST_VERSION-macos-aarch64.tar.xz"
    tar -xJf "$tmp/pgrst.tar.xz" -C "$BIN_DIR" postgrest
  fi
  if [[ ! -x "$BIN_DIR/auth" ]]; then
    curl -fsSL -o "$tmp/auth.tar.gz" \
      "https://github.com/supabase/auth/releases/download/$GOTRUE_VERSION/auth-$GOTRUE_VERSION-darwin-arm64.tar.gz"
    tar -xzf "$tmp/auth.tar.gz" -C "$BIN_DIR"
  fi
  [[ -x "$BIN_DIR/postgrest" && -x "$BIN_DIR/auth" && -d "$BIN_DIR/migrations" ]] || die "binaries missing in $BIN_DIR"
  echo "postgrest: $("$BIN_DIR/postgrest" --version 2>&1 | head -1)"
  echo "auth: $GOTRUE_VERSION ($(ls "$BIN_DIR/migrations" | wc -l | tr -d ' ') migrations)"
}

need_bins() {
  [[ -x "$BIN_DIR/postgrest" && -x "$BIN_DIR/auth" ]] || die "run 'tm-dev setup' first"
}

# ---------------------------------------------------------------- processes

pid_alive() { [[ -f "$STATE_DIR/$1.pid" ]] && kill -0 "$(cat "$STATE_DIR/$1.pid")" 2>/dev/null; }

stop_services() {
  local name
  for name in postgrest gotrue; do
    if pid_alive "$name"; then kill "$(cat "$STATE_DIR/$name.pid")" 2>/dev/null || true; fi
    rm -f "$STATE_DIR/$name.pid"
  done
  sleep 1
}

port_free() { ! lsof -iTCP:"$1" -sTCP:LISTEN -n -P >/dev/null 2>&1; }

wait_http() {  # wait_http <url> <name>
  local i
  for i in $(seq 1 30); do
    curl -fsS -o /dev/null "$1" 2>/dev/null && return 0
    pid_alive "$2" || break
    sleep 1
  done
  die "$2 did not answer at $1 — see $STATE_DIR/$2.log"
}

# start_services <pgrst_db_uri> <gotrue_db_url> <jwt_secret> <signup_disabled>
start_services() {
  need_bins
  stop_services
  port_free "$POSTGREST_PORT" || die "port $POSTGREST_PORT is in use"
  port_free "$GOTRUE_PORT" || die "port $GOTRUE_PORT is in use"
  mkdir -p "$STATE_DIR"

  # Google 로그인은 local 모드에서 TM_DEV_GOOGLE=1 일 때만 (운영 OAuth 클라이언트 + localhost 리디렉션 URI 등록 필요)
  local google_enabled=false google_id="" google_secret=""
  if [[ "${TM_DEV_GOOGLE:-0}" == 1 ]]; then
    [[ "$4" == false ]] || die "TM_DEV_GOOGLE=1 is only for local mode"
    load_env "$GOOGLE_ENV"
    : "${GOOGLE_CLIENT_ID:?missing in $GOOGLE_ENV}" "${GOOGLE_CLIENT_SECRET:?missing in $GOOGLE_ENV}"
    google_enabled=true google_id="$GOOGLE_CLIENT_ID" google_secret="$GOOGLE_CLIENT_SECRET"
  fi

  PGRST_DB_URI="$1" PGRST_JWT_SECRET="$3" PGRST_DB_SCHEMAS=public PGRST_DB_ANON_ROLE=anon \
  PGRST_DB_MAX_ROWS=1000 PGRST_DB_POOL=3 PGRST_SERVER_HOST=127.0.0.1 PGRST_SERVER_PORT="$POSTGREST_PORT" \
    nohup "$BIN_DIR/postgrest" > "$STATE_DIR/postgrest.log" 2>&1 < /dev/null &
  echo $! > "$STATE_DIR/postgrest.pid"
  disown

  ( cd "$BIN_DIR"
    GOTRUE_DB_DRIVER=postgres DATABASE_URL="$2" GOTRUE_DB_MIGRATIONS_PATH="$BIN_DIR/migrations" \
    GOTRUE_JWT_SECRET="$3" GOTRUE_JWT_EXP=3600 GOTRUE_JWT_AUD=authenticated \
    GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated GOTRUE_JWT_ADMIN_ROLES=service_role \
    API_EXTERNAL_URL="$DEV_ORIGIN/auth/v1" GOTRUE_SITE_URL="$DEV_ORIGIN" GOTRUE_URI_ALLOW_LIST="$DEV_ORIGIN/**" \
    GOTRUE_API_HOST=127.0.0.1 GOTRUE_API_PORT="$GOTRUE_PORT" PORT="$GOTRUE_PORT" \
    GOTRUE_DISABLE_SIGNUP="$4" GOTRUE_EXTERNAL_EMAIL_ENABLED=true \
    GOTRUE_MAILER_AUTOCONFIRM="$([[ "$4" == false ]] && echo true || echo false)" \
    GOTRUE_EXTERNAL_GOOGLE_ENABLED="$google_enabled" GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID="$google_id" \
    GOTRUE_EXTERNAL_GOOGLE_SECRET="$google_secret" GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI="$DEV_ORIGIN/auth/v1/callback" \
      nohup "$BIN_DIR/auth" > "$STATE_DIR/gotrue.log" 2>&1 < /dev/null &
    echo $! > "$STATE_DIR/gotrue.pid"
    disown )

  wait_http "http://127.0.0.1:$POSTGREST_PORT/" postgrest
  wait_http "http://127.0.0.1:$GOTRUE_PORT/health" gotrue
}

# write_override <mode> <anon_jwt> <service_jwt> <storage_conn>
write_override() {
  umask 077
  cat > "$OVERRIDE" <<EOF
# Written by 05-harness/scripts/tm-dev ($1). Run 'tm-dev off' to fall back to .env.local.
TM_DEV_MODE=$1
NEXT_PUBLIC_SUPABASE_URL=$DEV_ORIGIN
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$2
SUPABASE_SECRET_KEY=$3
SUPABASE_REST_INTERNAL_URL=http://127.0.0.1:$POSTGREST_PORT
SUPABASE_AUTH_INTERNAL_URL=http://127.0.0.1:$GOTRUE_PORT
AZURE_STORAGE_CONNECTION_STRING=$4
NEXT_PUBLIC_APP_URL=$DEV_ORIGIN
RESEND_API_KEY=
CRON_SECRET=
CRON_ALLOW_UNAUTHENTICATED=0
EOF
}

# ---------------------------------------------------------------- local database

jwt() {  # jwt <secret> <role> — HS256, 10-year expiry, same claims as the production keys
  python3 - "$1" "$2" <<'PY'
import base64, hashlib, hmac, json, sys, time
secret, role = sys.argv[1], sys.argv[2]
b64 = lambda b: base64.urlsafe_b64encode(b).rstrip(b"=").decode()
now = int(time.time())
head = b64(json.dumps({"alg": "HS256", "typ": "JWT"}, separators=(",", ":")).encode())
body = b64(json.dumps({"role": role, "iss": "tester-match-local", "iat": now, "exp": now + 10 * 365 * 86400}, separators=(",", ":")).encode())
sig = b64(hmac.new(secret.encode(), f"{head}.{body}".encode(), hashlib.sha256).digest())
print(f"{head}.{body}.{sig}")
PY
}

random_secret() { python3 -c 'import secrets; print(secrets.token_hex(32))'; }

ensure_local_env() {
  [[ -f "$LOCAL_ENV" ]] && return 0
  mkdir -p "$CONFIG_DIR"; chmod 700 "$CONFIG_DIR"
  local secret; secret="$(random_secret)"
  umask 077
  cat > "$LOCAL_ENV" <<EOF
# tester-match local dev database (tm-dev local). Generated $(date +%F). Local only.
JWT_SECRET='$secret'
ANON_JWT='$(jwt "$secret" anon)'
SERVICE_JWT='$(jwt "$secret" service_role)'
AUTHENTICATOR_PASSWORD='$(random_secret)'
AUTH_ADMIN_PASSWORD='$(random_secret)'
EOF
}

cmd_local_init() {
  local with_data=false
  [[ "${1:-}" == --with-prod-data ]] && with_data=true
  need_bins
  load_env "$PROD_ENV"
  : "${PG_ADMIN_URI:?PG_ADMIN_URI missing in $PROD_ENV}"
  ensure_local_env
  load_env "$LOCAL_ENV"
  command -v pg_dump >/dev/null || die "pg_dump not found"

  local work local_admin
  work="$(mktemp -d)"; chmod 700 "$work"
  trap 'rm -rf "$work"' RETURN
  local_admin=(-h "$LOCAL_PGHOST" -p "$LOCAL_PGPORT")
  psql "${local_admin[@]}" -d postgres -tAc "select 1" >/dev/null 2>&1 \
    || die "local PostgreSQL not reachable at $LOCAL_PGHOST:$LOCAL_PGPORT (brew services start postgresql@17)"

  echo "== 1. read production schema$([[ $with_data == true ]] && echo ' and data') (read-only)"
  pg_dump "$PG_ADMIN_URI" --schema-only -n public --no-owner --no-privileges -f "$work/schema_public.sql"
  if [[ $with_data == true ]]; then
    pg_dump "$PG_ADMIN_URI" --data-only -n public --no-owner --no-privileges -f "$work/data_public.sql"
    pg_dump "$PG_ADMIN_URI" --data-only -t auth.users -t auth.identities --no-owner --no-privileges -f "$work/data_auth.sql"
  fi

  stop_services
  echo "== 2. rebuild local database $LOCAL_DB"
  psql "${local_admin[@]}" -d postgres -v ON_ERROR_STOP=1 -q \
    -c "select pg_terminate_backend(pid) from pg_stat_activity where datname = '$LOCAL_DB' and pid <> pg_backend_pid()" \
    -c "drop database if exists $LOCAL_DB" -c "create database $LOCAL_DB" >/dev/null
  psql "${local_admin[@]}" -d "$LOCAL_DB" -q \
    -v authenticator_password="$AUTHENTICATOR_PASSWORD" -v auth_admin_password="$AUTH_ADMIN_PASSWORD" \
    -f "$DB_SQL_DIR/01-roles.sql" >/dev/null

  echo "== 3. GoTrue auth schema"
  local auth_url="postgres://supabase_auth_admin:$AUTH_ADMIN_PASSWORD@$LOCAL_PGHOST:$LOCAL_PGPORT/$LOCAL_DB?sslmode=disable&search_path=auth"
  ( cd "$BIN_DIR"
    GOTRUE_DB_DRIVER=postgres GOTRUE_DB_MIGRATIONS_PATH="$BIN_DIR/migrations" DATABASE_URL="$auth_url" \
    GOTRUE_JWT_SECRET="$JWT_SECRET" API_EXTERNAL_URL=http://localhost/auth/v1 GOTRUE_SITE_URL=http://localhost \
      ./auth migrate >/dev/null 2>&1 ) || die "GoTrue migrate failed"
  psql "${local_admin[@]}" -d "$LOCAL_DB" -v ON_ERROR_STOP=1 -q \
    -c "set role supabase_auth_admin; grant references, trigger, select on auth.users to current_user;" >/dev/null 2>&1 || true

  echo "== 4. public schema, grants, auth triggers"
  [[ $with_data == true ]] && psql "${local_admin[@]}" -d "$LOCAL_DB" -v ON_ERROR_STOP=1 -q \
    -c "set role supabase_auth_admin" -f "$work/data_auth.sql" >/dev/null
  # the dump's "create schema public" is the only expected error
  if psql "${local_admin[@]}" -d "$LOCAL_DB" -q -f "$work/schema_public.sql" 2>&1 \
      | grep ERROR | grep -v 'schema "public" already exists'; then
    die "schema restore errors"
  fi
  if [[ $with_data == true ]]; then
    psql "${local_admin[@]}" -d "$LOCAL_DB" -v ON_ERROR_STOP=1 -q -f "$work/data_public.sql" >/dev/null
  else
    psql "${local_admin[@]}" -d "$LOCAL_DB" -v ON_ERROR_STOP=1 -q -f "$SEED_SQL" >/dev/null
  fi
  psql "${local_admin[@]}" -d "$LOCAL_DB" -q -f "$DB_SQL_DIR/03-grants.sql" >/dev/null 2>&1
  psql "${local_admin[@]}" -d "$LOCAL_DB" -q -c "set role supabase_auth_admin" \
    -f "$DB_SQL_DIR/04-auth-triggers.sql" >/dev/null 2>&1

  echo "== 5. counts"
  psql "${local_admin[@]}" -d "$LOCAL_DB" -tAc \
    "select 'tables=' || count(*) from information_schema.tables where table_schema = 'public'
     union all select 'users=' || count(*) from public.users
     union all select 'auth.users=' || count(*) from auth.users
     union all select 'apps=' || count(*) from public.apps"
  echo "local database ready — run 'tm-dev local'"
}

# ---------------------------------------------------------------- modes

cmd_local() {
  load_env "$LOCAL_ENV"
  psql -h "$LOCAL_PGHOST" -p "$LOCAL_PGPORT" -d "$LOCAL_DB" -tAc "select 1" >/dev/null 2>&1 \
    || die "local database $LOCAL_DB missing — run 'tm-dev local-init'"
  start_services \
    "postgres://authenticator:$AUTHENTICATOR_PASSWORD@$LOCAL_PGHOST:$LOCAL_PGPORT/$LOCAL_DB?sslmode=disable" \
    "postgres://supabase_auth_admin:$AUTH_ADMIN_PASSWORD@$LOCAL_PGHOST:$LOCAL_PGPORT/$LOCAL_DB?sslmode=disable&search_path=auth" \
    "$JWT_SECRET" false
  write_override local "$ANON_JWT" "$SERVICE_JWT" ""
  echo "mode: local — PostgreSQL $LOCAL_PGHOST:$LOCAL_PGPORT/$LOCAL_DB (signup on, email auto-confirmed)"
}

cmd_prod() {
  load_env "$PROD_ENV"
  : "${JWT_SECRET:?missing in $PROD_ENV}" "${ANON_JWT:?}" "${SERVICE_JWT:?}" "${PGRST_DB_URI:?}" "${GOTRUE_DATABASE_URL:?}"
  start_services "$PGRST_DB_URI" "$GOTRUE_DATABASE_URL" "$JWT_SECRET" true
  write_override prod "$ANON_JWT" "$SERVICE_JWT" "${AZURE_STORAGE_CONNECTION_STRING:-}"
  echo "mode: PROD — Azure PostgreSQL"
  echo "WARNING: reads and writes hit production data. Mail, cron, signup and Google login are off."
}

cmd_off() {
  stop_services
  rm -f "$OVERRIDE"
  echo "mode: off — services stopped, .env.local in effect"
}

cmd_status() {
  if [[ -f "$OVERRIDE" ]]; then
    echo "mode: $(sed -n 's/^TM_DEV_MODE=//p' "$OVERRIDE")"
  else
    echo "mode: off (.env.local)"
  fi
  local name
  for name in postgrest gotrue; do
    if pid_alive "$name"; then echo "  $name running (pid $(cat "$STATE_DIR/$name.pid"))"; else echo "  $name stopped"; fi
  done
}

case "${1:-status}" in
  setup)      cmd_setup ;;
  local-init) shift; cmd_local_init "$@" ;;
  local)      cmd_local ;;
  prod)       cmd_prod ;;
  off)        cmd_off ;;
  status)     cmd_status ;;
  *) die "usage: tm-dev setup|local-init [--with-prod-data]|local|prod|off|status" ;;
esac
