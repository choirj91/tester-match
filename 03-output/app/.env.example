# ====================================================================
# Tester Match — 환경 변수 템플릿
# .env.local 로 복사 후 실제 값을 채워 사용. .env.local 은 git 추적 X.
# ====================================================================

# ── Supabase ────────────────────────────────────────────────────────
# 신 키 규격(2025+): publishable(클라이언트) / secret(서버). 구 anon/service_role 도 호환.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# ── Resend (메인 메일) ──────────────────────────────────────────────
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=hello@YOUR_DOMAIN

# ── Brevo (백업 메일, 100/일 초과 시 fallback) ──────────────────────
BREVO_API_KEY=xkeysib-xxx
BREVO_FROM_EMAIL=hello@YOUR_DOMAIN

# ── Slack (1:1 문의 접수 알림) ──────────────────────────────────────
# 수신 웹훅(Incoming Webhook) 주소. 비워 두면 Slack 전송만 건너뛴다 (문의 접수는 정상).
SLACK_INQUIRY_WEBHOOK_URL=
# 운영 알림(일일 리포트·크레딧 이상 징후) Slack 웹훅 — 비우면 SLACK_INQUIRY_WEBHOOK_URL 채널로 보낸다
SLACK_OPS_WEBHOOK_URL=

# ── 포트원 V2 (유료 테스터 카드 결제, PG: NHN KCP — ADR-0011) ───────
# 상점 ID·채널 키는 결제창이 브라우저에서 사용 → NEXT_PUBLIC_ 필수.
# API 시크릿은 서버의 결제 조회 전용 — 절대 NEXT_PUBLIC_ 로 두지 않는다.
NEXT_PUBLIC_PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORTONE_API_SECRET=

# ── 인증 (Supabase Auth — ADR-0004) ─────────────────────────────────
# Google OAuth 자격증명은 Supabase Dashboard → Authentication → Providers
# 에서 설정. 앱 .env 에 보관하지 않음.

# ── Cron 보호 ────────────────────────────────────────────────────────
# Cloudflare Cron Trigger 호출 시 Authorization: Bearer ${CRON_SECRET} 검증.
# 운영에서 반드시 설정. openssl rand -hex 32.
CRON_SECRET=

# ── Sentry / PostHog (관찰성) ────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=

# ── 앱 설정 ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tester Match
